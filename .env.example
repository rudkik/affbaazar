# --- Домен и прокси (make caddy / docker-compose) ---
DOMAIN=affbazaar.com
# 1 — сайт также на www (нужна A-запись), 0 — только голый домен
WWW=1
# Порт бота на хосте (127.0.0.1) для проверок. 8081, т.к. 8080 занят проектом affbiz
BOT_PORT=8081
# Docker-сеть, в которой живёт Caddy проекта affbiz (бот подключается к ней). Если Caddy на хосте — не используется
CADDY_NETWORK=affbiz_default
# Контейнер Caddy и его Caddyfile на хосте. Пусто = make caddy определит сам
CADDY_CONTAINER=
CADDYFILE=

# --- Telegram ---
BOT_TOKEN=123456:ABC-DEF...
# ID администраторов бота через запятую (числовые Telegram ID)
ADMINS=123456789,987654321

# --- Веб-панель / сайт ---
WEB_HOST=0.0.0.0
WEB_PORT=8080
# Пароль входа в /admin
ADMIN_PASSWORD=change-me
# Секрет для подписи cookie сессии
SECRET_KEY=change-me-too
# Публичный адрес сайта (для ссылок из бота)
PUBLIC_URL=https://affbazaar.com

# --- Бот поддержки (@aff_bazzar_support_bot) ---
# Токен второго бота от @BotFather. Пусто = бот поддержки не запускается.
SUPPORT_BOT_TOKEN=
# ID форум-группы «Aff Bazaar Support Chats» (с включёнными топиками), бот там администратор
# с правом управлять топиками. Можно указать как -100XXXXXXXXXX, так и голый номер из ссылки.
SUPPORT_CHAT_ID=

# --- Оплата криптой (USDT/USDC через CryptoPay, см. INTEGRATION.md) ---
# Пусто = кнопка «Оплатить криптой» в боте не показывается.
# API-ключ сервиса из админки процессинга (Services → ваш сервис), вид cp_live_…
CRYPTOPAY_API_KEY=
# Webhook secret из карточки того же сервиса — им подписаны входящие вебхуки
CRYPTOPAY_WEBHOOK_SECRET=
# Адрес процессинга
CRYPTOPAY_BASE_URL=https://ubaduba.top
# Адрес вебхука, который надо вписать в карточку сервиса: ${PUBLIC_URL}/webhooks/cryptopay

# --- Хранилище ---
# Куда класть базы и логи. В Docker переопределяется на /app/data.
DATA_DIR=

# --- Telegram Mini App ---
# Адрес сайта, который откроется приложением внутри бота.
# Требуется HTTPS с валидным сертификатом; по умолчанию берётся PUBLIC_URL.
WEBAPP_URL=https://affbazaar.com
